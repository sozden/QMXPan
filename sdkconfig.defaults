# Flash ve bölümler (modül N16R8: 16 MB flash, 8 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# CMake projesi derleme klasöründe çalıştığı için mutlak yol gerekiyor
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="D:/QMXPan/partitions.csv"

# OTA: yeni yazılım ilk açılışta kendini "sağlam" işaretlemezse (ör. çökerse)
# önyükleyici bir önceki sürüme döner. USB yüklemede tools\flash.ps1 kullan
# (espflash'ın kendi önyükleyicisinde geri dönüş kapalı).
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTP sunucu (OTA ve WiFi kurulum sayfası)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# PSRAM: 800x480 ekran tamponu (750 KB) burada durur
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Flash yazılırken ekran kaymasın diye kod ve sabitler PSRAM'den çalışır
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# RGB ekran için önerilen önbellek ayarları
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

# USB host: QMX'in birleşik (ses + 2 seri port) tanımlayıcısı 256 bayttan büyük
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=2048

# İşlemci
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Yığınlar
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192
